@echo off
chcp 65001 >nul
title MOST Финансы — автозапуск
cd /d "%~dp0"
echo  Регистрирую задачу Windows: при входе пользователя в систему запускать сервер и туннель в свёрнутом окне.
schtasks /Create /F /SC ONLOGON /RL HIGHEST /TN "MOST Финансы" /TR "cmd /c start /min \"MOST Финансы\" \"%~dp0start-internet.bat\""
if errorlevel 1 (
  echo  Не удалось создать задачу. Запустите этот файл от имени администратора.
) else (
  echo  Готово. Проверить: Планировщик заданий → «MOST Финансы». Удалить: schtasks /Delete /TN "MOST Финансы" /F
  echo  Чтобы система работала и без входа пользователя, в Планировщике откройте задачу → «Выполнять вне зависимости от регистрации пользователя».
)
pause
